# WhatsApp Cloud API
ACCESS_TOKEN=your_permanent_meta_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=vip_bot_2026

# Admin (digits; 212… recommended)
ADMIN_PHONE=212625489153

# Public site / webhook base (no trailing slash)
